hit <- intersect(cands, pool)
if (length(hit) == 0) NA_character_ else hit[[1]]
}
pool <- names(df)
species_col     <- pick_col(aliases$species, pool)
lq_col          <- pick_col(aliases$lq, pool)
superfamily_col <- pick_col(aliases$superfamily, pool)
if (any(is.na(c(species_col, lq_col, superfamily_col)))) {
stop(paste0(
"Required columns not found after cleaning.\nGot: ",
paste(names(df), collapse=", "),
"\nLooking for: species, lq, superfamily (any alias)."
))
}
# Canonicalize columns
df <- df %>%
transmute(
species     = .data[[species_col]],
lq          = suppressWarnings(as.numeric(.data[[lq_col]])),
superfamily = .data[[superfamily_col]]
) %>%
filter(!is.na(lq), !is.na(species), species != "")
# ---- OPTIONAL: harmonize underscores/spaces if needed ----
# df$species     <- gsub(" ", "_", df$species)
# tree$tip.label <- gsub("_", " ", tree$tip.label)
# ---- Prune tree & align ----
species_in_both <- intersect(tree$tip.label, df$species)
if (length(species_in_both) < 3) {
stop("Not enough overlapping species. Check naming between tree tips and df$species.")
}
tree_pruned <- drop.tip(tree, setdiff(tree$tip.label, species_in_both))
df_plot <- df %>%
filter(species %in% species_in_both) %>%
mutate(species = factor(species, levels = tree_pruned$tip.label))
tip_map <- df_plot %>%
distinct(species, superfamily) %>%
rename(label = species)
# ---- Base circular tree ----
p <- ggtree(tree_pruned, layout = "circular", size = 0.4)
# Color terminal branches by superfamily; internal branches grey
p$data <- p$data %>%
left_join(tip_map, by = "label") %>%
mutate(branch_group = ifelse(isTip, superfamily, "internal"))
sup_levels <- sort(na.omit(unique(tip_map$superfamily)))
sup_cols   <- setNames(hue_pal()(length(sup_levels)), sup_levels)
all_cols   <- c(internal = "grey75", sup_cols)
p <- p +
aes(color = branch_group) +
scale_color_manual(values = all_cols, name = "Branch color") +
theme(
legend.position = "right",
plot.margin = margin(5, 5, 5, 5)
)
# ---- Bars (LQ) around the tree) ----
bars <- df %>%
filter(!is.na(lq), species %in% tree_pruned$tip.label) %>%
select(species, lq, superfamily) %>%
mutate(species = factor(species, levels = tree_pruned$tip.label))
p <- p + ggnewscale::new_scale_fill()
# >>> KEY FIX: bare column names in aes(), NOT .data$... <<<
p <- p +
ggtreeExtra::geom_fruit(
data        = bars,
geom        = geom_bar,
mapping     = aes(y = species, x = lq, fill = superfamily),
orientation = "y",
stat        = "identity",
width       = 0.6,
offset      = 0.02
) +
scale_fill_discrete(name = "Superfamily (bars)") +
labs(
title    = "LQ along the phylogeny",
subtitle = "Circular tree with tip bars for LQ; terminal branches colored by Superfamily"
)
# p <- p + geom_tiplab(size = 2)  # optional
ggsave("LQ_circular_tree.png", p, width = 10, height = 10, dpi = 300)
print(names(df)); print(head(df)); print(head(bars)); head(tree_pruned$tip.label)
# =============================
# Circular phylogeny + LQ bars
# Avoid column-name collisions between tree data and fruit data
# =============================
# ---- Packages ----
# install.packages(c("ape","dplyr","ggplot2"))
# if (!requireNamespace("BiocManager", quietly = TRUE)) install.packages("BiocManager")
# BiocManager::install(c("ggtree","treeio"))
# install.packages(c("ggtreeExtra","ggnewscale"))
library(ape)
library(dplyr)
library(ggplot2)
library(ggtree)        # Bioconductor
library(ggtreeExtra)   # for geom_fruit()
library(ggnewscale)    # to reset fill/color scales
library(scales)        # for hue_pal()
# ---- Input ----
tree <- read.tree("phylogeny.nw")
df   <- read.table("lqdf.tab", header = TRUE, sep = "\t",
stringsAsFactors = FALSE, check.names = FALSE)
# ---- Clean & standardize column names (lowercase, trim) ----
clean_names <- function(x) {
x <- gsub("[\r\n\t]", "", x)  # strip control chars
x <- trimws(x)                # trim spaces
x <- tolower(x)               # lower case
x <- gsub("\\s+", "_", x)     # internal spaces -> underscore
x
}
names(df) <- clean_names(names(df))
# Expected fields
aliases <- list(
species     = c("species","specie","taxon","taxa"),
lq          = c("lq","trait","phenotype"),
superfamily = c("superfamily","super_fam","superfam","super-family")
)
pick_col <- function(cands, pool) {
hit <- intersect(cands, pool)
if (length(hit) == 0) NA_character_ else hit[[1]]
}
pool <- names(df)
species_col     <- pick_col(aliases$species, pool)
lq_col          <- pick_col(aliases$lq, pool)
superfamily_col <- pick_col(aliases$superfamily, pool)
if (any(is.na(c(species_col, lq_col, superfamily_col)))) {
stop(paste0(
"Required columns not found after cleaning.\nGot: ",
paste(names(df), collapse=", "),
"\nLooking for: species, lq, superfamily (any alias)."
))
}
# Canonicalize columns
df <- df %>%
transmute(
species     = .data[[species_col]],
lq          = suppressWarnings(as.numeric(.data[[lq_col]])),
superfamily = .data[[superfamily_col]]
) %>%
filter(!is.na(lq), !is.na(species), species != "")
# ---- OPTIONAL: harmonize underscores/spaces if needed ----
# df$species     <- gsub(" ", "_", df$species)
# tree$tip.label <- gsub("_", " ", tree$tip.label)
# ---- Prune tree & align ----
species_in_both <- intersect(tree$tip.label, df$species)
if (length(species_in_both) < 3) {
stop("Not enough overlapping species. Check naming between tree tips and df$species.")
}
tree_pruned <- drop.tip(tree, setdiff(tree$tip.label, species_in_both))
df_plot <- df %>%
filter(species %in% species_in_both) %>%
mutate(species = factor(species, levels = tree_pruned$tip.label))
tip_map <- df_plot %>%
distinct(species, superfamily) %>%
rename(label = species)
# ---- Base circular tree ----
p <- ggtree(tree_pruned, layout = "circular", size = 0.4)
# Color terminal branches by superfamily; internal branches grey
# CRUCIAL: rename 'superfamily' joined into tree data to avoid collision
p$data <- p$data %>%
left_join(tip_map, by = "label") %>%
rename(tip_superfamily = superfamily) %>%                # <-- rename here
mutate(branch_group = ifelse(isTip, tip_superfamily, "internal"))
sup_levels <- sort(na.omit(unique(tip_map$tip_superfamily)))
# tip_map just changed variable name; rebuild it for palette
sup_levels <- sort(na.omit(unique(p$data$tip_superfamily)))
sup_cols   <- setNames(hue_pal()(length(sup_levels)), sup_levels)
all_cols   <- c(internal = "grey75", sup_cols)
p <- p +
aes(color = branch_group) +
scale_color_manual(values = all_cols, name = "Branch color") +
theme(
legend.position = "right",
plot.margin = margin(5, 5, 5, 5)
)
# ---- Bars (LQ) around the tree ----
# Rename bar-side superfamily to avoid name collision with tree data
bars <- df %>%
filter(!is.na(lq), species %in% tree_pruned$tip.label) %>%
select(species, lq, superfamily) %>%
mutate(
species = factor(species, levels = tree_pruned$tip.label),
bar_superfamily = superfamily
) %>%
select(-superfamily)
# Reset fill scale so bars have their own legend
p <- p + ggnewscale::new_scale_fill()
p <- p +
ggtreeExtra::geom_fruit(
data        = bars,
geom        = geom_bar,
mapping     = aes(y = species, x = lq, fill = bar_superfamily),
orientation = "y",
stat        = "identity",
width       = 0.6,
offset      = 0.02,
inherit.aes = FALSE                                   # <-- important
) +
scale_fill_discrete(name = "Superfamily (bars)") +
labs(
title    = "LQ along the phylogeny",
subtitle = "Circular tree with tip bars for LQ; terminal branches colored by Superfamily"
)
# p <- p + geom_tiplab(size = 2)  # optional
ggsave("LQ_circular_tree.png", p, width = 10, height = 10, dpi = 300)
print(p)
# =============================
# Circular phylogeny + LQ bars
# Ultrametric plotting so all tips co-terminate
# Avoid column-name collisions between tree data and fruit data
# =============================
# ---- Packages ----
# install.packages(c("ape","dplyr","ggplot2"))
# if (!requireNamespace("BiocManager", quietly = TRUE)) install.packages("BiocManager")
# BiocManager::install(c("ggtree","treeio"))
# install.packages(c("ggtreeExtra","ggnewscale"))
library(ape)
library(dplyr)
library(ggplot2)
library(ggtree)        # Bioconductor
library(ggtreeExtra)   # for geom_fruit()
library(ggnewscale)    # to reset fill/color scales
library(scales)        # for hue_pal()
library(phytools)      # for force.ultrametric
# ---- Input ----
tree <- read.tree("phylogeny.nw")
df   <- read.table("lqdf.tab", header = TRUE, sep = "\t",
stringsAsFactors = FALSE, check.names = FALSE)
# ---- Clean & standardize column names (lowercase, trim) ----
clean_names <- function(x) {
x <- gsub("[\r\n\t]", "", x)  # strip control chars
x <- trimws(x)                # trim spaces
x <- tolower(x)               # lower case
x <- gsub("\\s+", "_", x)     # internal spaces -> underscore
x
}
names(df) <- clean_names(names(df))
# Expected fields
aliases <- list(
species     = c("species","specie","taxon","taxa"),
lq          = c("lq","trait","phenotype"),
superfamily = c("superfamily","super_fam","superfam","super-family")
)
pick_col <- function(cands, pool) {
hit <- intersect(cands, pool)
if (length(hit) == 0) NA_character_ else hit[[1]]
}
pool <- names(df)
species_col     <- pick_col(aliases$species, pool)
lq_col          <- pick_col(aliases$lq, pool)
superfamily_col <- pick_col(aliases$superfamily, pool)
if (any(is.na(c(species_col, lq_col, superfamily_col)))) {
stop(paste0(
"Required columns not found after cleaning.\nGot: ",
paste(names(df), collapse=", "),
"\nLooking for: species, lq, superfamily (any alias)."
))
}
# Canonicalize columns
df <- df %>%
transmute(
species     = .data[[species_col]],
lq          = suppressWarnings(as.numeric(.data[[lq_col]])),
superfamily = .data[[superfamily_col]]
) %>%
filter(!is.na(lq), !is.na(species), species != "")
# ---- OPTIONAL: harmonize underscores/spaces if needed ----
# df$species     <- gsub(" ", "_", df$species)
# tree$tip.label <- gsub("_", " ", tree$tip.label)
# ---- Prune tree & align ----
species_in_both <- intersect(tree$tip.label, df$species)
if (length(species_in_both) < 3) {
stop("Not enough overlapping species. Check naming between tree tips and df$species.")
}
tree_pruned <- drop.tip(tree, setdiff(tree$tip.label, species_in_both))
# --- Make ultrametric copy for plotting so all tips co-terminate ---
tree_ultra <- phytools::force.ultrametric(tree_pruned, method = "extend")
# Guard against zero/non-positive edge lengths
tree_ultra$edge.length[tree_ultra$edge.length <= 0] <- 1e-6
# Align df order to ultrametric tree tip order
df_plot <- df %>%
filter(species %in% tree_ultra$tip.label) %>%
mutate(species = factor(species, levels = tree_ultra$tip.label))
# Tip-level map for branch coloring
tip_map <- df_plot %>%
distinct(species, superfamily) %>%
rename(label = species)
# ---- Base circular tree (ULTRAMETRIC) ----
p <- ggtree(tree_ultra, layout = "circular", size = 0.4)
# Color terminal branches by superfamily; internal branches grey
# Rename joined column to avoid collision with fruit data
p$data <- p$data %>%
left_join(tip_map, by = "label") %>%
rename(tip_superfamily = superfamily) %>%
mutate(branch_group = ifelse(isTip, tip_superfamily, "internal"))
# Build palette
sup_levels <- sort(na.omit(unique(p$data$tip_superfamily)))
sup_cols   <- setNames(hue_pal()(length(sup_levels)), sup_levels)
all_cols   <- c(internal = "grey75", sup_cols)
p <- p +
aes(color = branch_group) +
scale_color_manual(values = all_cols, name = "Branch color") +
theme(
legend.position = "right",
plot.margin = margin(5, 5, 5, 5)
)
# ---- Bars (LQ) around the tree ----
# Build 'bars' strictly matching ultrametric tip order; rename superfamily to avoid collision
bars <- df %>%
filter(!is.na(lq), species %in% tree_ultra$tip.label) %>%
select(species, lq, superfamily) %>%
mutate(
species = factor(species, levels = tree_ultra$tip.label),
bar_superfamily = superfamily
) %>%
select(-superfamily)
# Reset fill scale so bars have their own legend
p <- p + ggnewscale::new_scale_fill()
p <- p +
ggtreeExtra::geom_fruit(
data        = bars,
geom        = geom_bar,
mapping     = aes(y = species, x = lq, fill = bar_superfamily),
orientation = "y",
stat        = "identity",
width       = 0.6,
offset      = 0.02,
inherit.aes = FALSE
) +
scale_fill_discrete(name = "Superfamily (bars)") +
labs(
title    = "LQ along the phylogeny",
subtitle = "Circular ultrametric tree with tip bars for LQ; terminal branches colored by Superfamily"
)
# p <- p + geom_tiplab(size = 2)  # optional (can be cluttered)
ggsave("LQ_circular_tree.png", p, width = 10, height = 10, dpi = 300)
print(p)
# =============================
# Circular ultrametric tree + LQ bars
# Branches in plain color (no superfamily mapping)
# =============================
library(ape)
library(dplyr)
library(ggplot2)
library(ggtree)
library(ggtreeExtra)
library(ggnewscale)
library(scales)
library(phytools)
# ---- Input ----
tree <- read.tree("phylogeny.nw")
df   <- read.table("lqdf.tab", header = TRUE, sep = "\t",
stringsAsFactors = FALSE, check.names = FALSE)
# ---- Clean & standardize column names ----
clean_names <- function(x) {
x <- gsub("[\r\n\t]", "", x)
x <- trimws(x)
x <- tolower(x)
gsub("\\s+", "_", x)
}
names(df) <- clean_names(names(df))
# Canonicalize columns
df <- df %>%
transmute(
species     = species,
lq          = suppressWarnings(as.numeric(lq)),
superfamily = superfamily
) %>%
filter(!is.na(lq), !is.na(species), species != "")
# ---- Prune tree & make ultrametric ----
species_in_both <- intersect(tree$tip.label, df$species)
tree_pruned <- drop.tip(tree, setdiff(tree$tip.label, species_in_both))
tree_ultra  <- phytools::force.ultrametric(tree_pruned, method = "extend")
tree_ultra$edge.length[tree_ultra$edge.length <= 0] <- 1e-6
# Align df to ultrametric tree
df_plot <- df %>%
filter(species %in% tree_ultra$tip.label) %>%
mutate(species = factor(species, levels = tree_ultra$tip.label))
# ---- Base circular tree (plain branches) ----
p <- ggtree(tree_ultra, layout = "circular", size = 0.4, color = "grey30") +
theme(
legend.position = "right",
plot.margin = margin(5, 5, 5, 5)
)
# ---- Bars (LQ) around the tree ----
bars <- df_plot %>%
select(species, lq, superfamily)
p <- p + ggnewscale::new_scale_fill()
p <- p +
ggtreeExtra::geom_fruit(
data        = bars,
geom        = geom_bar,
mapping     = aes(y = species, x = lq, fill = superfamily),
orientation = "y",
stat        = "identity",
width       = 0.6,
offset      = 0.02,
inherit.aes = FALSE
) +
scale_fill_discrete(name = "Superfamily (bars)") +
labs(
title    = "LQ along the phylogeny",
subtitle = "Circular ultrametric tree with tip bars for LQ"
)
# Optional tip labels
# p <- p + geom_tiplab(size = 2)
ggsave("LQ_circular_tree.png", p, width = 10, height = 10, dpi = 300)
print(p)
# =============================
# Circular ultrametric tree + LQ bars
# Branches in plain color (no superfamily mapping)
# =============================
library(ape)
library(dplyr)
library(ggplot2)
library(ggtree)
library(ggtreeExtra)
library(ggnewscale)
library(scales)
library(phytools)
# ---- Input ----
tree <- read.tree("phylogeny.nw")
df   <- read.table("lqdf.tab", header = TRUE, sep = "\t",
stringsAsFactors = FALSE, check.names = FALSE)
# ---- Clean & standardize column names ----
clean_names <- function(x) {
x <- gsub("[\r\n\t]", "", x)
x <- trimws(x)
x <- tolower(x)
gsub("\\s+", "_", x)
}
names(df) <- clean_names(names(df))
# Canonicalize columns
df <- df %>%
transmute(
species     = species,
lq          = suppressWarnings(as.numeric(lq)),
superfamily = superfamily
) %>%
filter(!is.na(lq), !is.na(species), species != "")
# ---- Prune tree & make ultrametric ----
species_in_both <- intersect(tree$tip.label, df$species)
tree_pruned <- drop.tip(tree, setdiff(tree$tip.label, species_in_both))
tree_ultra  <- phytools::force.ultrametric(tree_pruned, method = "extend")
tree_ultra$edge.length[tree_ultra$edge.length <= 0] <- 1e-6
# Align df to ultrametric tree
df_plot <- df %>%
filter(species %in% tree_ultra$tip.label) %>%
mutate(species = factor(species, levels = tree_ultra$tip.label))
# ---- Base circular tree (plain branches) ----
p <- ggtree(tree_ultra, layout = "circular", size = 0.4, color = "grey30") +
theme(
legend.position = "right",
plot.margin = margin(5, 5, 5, 5)
)
# ---- Bars (LQ) around the tree ----
bars <- df_plot %>%
select(species, lq, superfamily)
p <- p + ggnewscale::new_scale_fill()
p <- p +
ggtreeExtra::geom_fruit(
data        = bars,
geom        = geom_bar,
mapping     = aes(y = species, x = lq, fill = superfamily),
orientation = "y",
stat        = "identity",
width       = 0.6,
offset      = 0.02,
inherit.aes = FALSE
) +
scale_fill_discrete(name = "Superfamily (bars)") +
labs(
title    = "LQ along the phylogeny",
subtitle = "Circular ultrametric tree with tip bars for LQ"
)
# Optional tip labels
# p <- p + geom_tiplab(size = 2)
ggsave("LQ_circular_tree.png", p, width = 10, height = 10, dpi = 300)
print(p)
# =============================
# Densities of LQ (overall and by Superfamily)
# =============================
# Build a minimal dataframe for density plots
den_df <- df_plot %>%
dplyr::select(lq, superfamily) %>%
dplyr::filter(!is.na(lq))
# ---------- (1) Overall density in grey ----------
p_den_overall <- ggplot(den_df, aes(x = lq)) +
geom_density(fill = "grey70", color = "grey30", alpha = 0.85, adjust = 1) +
labs(
title = "Density of LQ (overall)",
x = "LQ",
y = "Density"
) +
theme_minimal(base_size = 12) +
theme(plot.margin = margin(5, 5, 5, 5))
ggsave("LQ_density_overall.png", p_den_overall, width = 7, height = 5, dpi = 300)
# ---------- (2) Density by Superfamily (same hue palette as bars) ----------
# Define levels & palette consistent with bar plot ring
sup_levels <- sort(unique(den_df$superfamily))
den_df$superfamily <- factor(den_df$superfamily, levels = sup_levels)
sup_palette <- setNames(scales::hue_pal()(length(sup_levels)), sup_levels)
p_den_by_sup <- ggplot(den_df, aes(x = lq, fill = superfamily)) +
geom_density(alpha = 0.4, color = NA, adjust = 1) +   # translucent fills, no outlines
scale_fill_manual(values = sup_palette, name = "Superfamily") +
labs(
title = "Density of LQ by Superfamily",
x = "LQ",
y = "Density"
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "right",
plot.margin = margin(5, 5, 5, 5)
)
ggsave("LQ_density_by_superfamily.png", p_den_by_sup, width = 7, height = 5, dpi = 300)
