remotes::install_github("anthonynorth/rscodeio")
rscodeio::install_theme()
setwd("/Users/fabio/science/projects/active/mcsa.metagenomics/thetree")
#!/usr/bin/env Rscript
# Carica le librerie
suppressMessages(library(ape))
# Legge l'albero dal file
tree <- read.tree("phylogeny.nw")
# Visualizza in stile fan (circolare), nero su bianco, linee grosse
plot(
tree,
type = "fan",
edge.width = 4,
edge.color = "black",
show.tip.label = FALSE,
no.margin = TRUE
)
# Carica le librerie
library(ape)
# Legge l'albero
tree <- read.tree("phylogeny.nw")
# Salva il grafico con sfondo trasparente
png("phylogeny_circular_transparent.png", width = 1500, height = 1500, res = 300, bg = "transparent")
# Disegna l'albero
plot(
tree,
type = "fan",
edge.width = 4,
edge.color = "black",
show.tip.label = FALSE,
no.margin = TRUE
)
dev.off()
